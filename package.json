{
  "name": "betazed-mongodb",
  "version": "0.0.1",
  "description": "out-of-the-box application architecture which allows developers and teams to create highly testable, scalable, loosely coupled, and easily maintainable application",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file=.env.local node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file=.env.local node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file=.env.local node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node --env-file=.env.local dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.cjs",
    "db:init": "node scripts/initialize-mongodb.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "mongoose": "9.10.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.1",
    "typescript-eslint": "8.71.0",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
